---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactSection from "../../components/ContactSection.astro";
import {
  fallbackMedia,
  getBlogPosts,
  getClinicContent,
  plainText,
  postImage,
} from "../../lib/wordpress";

const content = await getClinicContent();
const posts = [...getBlogPosts(content)].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
);
const heroImage = posts[0] ? postImage(content, posts[0]) : fallbackMedia.hero;
const featuredPost = posts[0];
const archivePosts = posts.slice(1);
const formatDate = (date: string) =>
  new Intl.DateTimeFormat("es-ES", { day: "2-digit", month: "long", year: "numeric" }).format(
    new Date(date),
  );
---

<BaseLayout
  title="Blog veterinario | Clínica Veterinaria Jara"
  description="Consejos, prevención y actualidad veterinaria del equipo de Clínica Veterinaria Jara."
  image={heroImage}
>
  <main class="blog-page">
    <header class="blog-masthead section-shell">
      <div class="blog-masthead-index">
        <p class="page-kicker">Cuaderno clínico · Jara</p>
        <span class="tabular">Lecturas para convivir mejor</span>
      </div>
      <h1>Conocer<br /><i>también</i> es cuidar.</h1>
      <p class="blog-masthead-intro">
        Guías claras sobre prevención, salud y bienestar, escritas desde la experiencia de
        acompañar a animales y familias cada día.
      </p>
      <figure class="blog-masthead-crop" aria-hidden="true">
        <img src={heroImage} alt="" width="640" height="880" decoding="async" />
        <figcaption class="tabular">J / 01</figcaption>
      </figure>
    </header>

    {featuredPost && (
      <section class="blog-feature section-shell" aria-labelledby="blog-feature-title">
        <a class="blog-feature-media" href={`/blog/${featuredPost.slug}/`}>
          <img
            src={postImage(content, featuredPost)}
            alt={`Imagen del artículo: ${plainText(featuredPost.title.rendered)}`}
            width="1500"
            height="980"
            fetchpriority="high"
            decoding="async"
          />
          <span class="blog-feature-marker tabular" aria-hidden="true">01</span>
        </a>
        <article class="blog-feature-copy">
          <div class="blog-card-meta">
            <span>En portada</span>
            <time datetime={featuredPost.date}>{formatDate(featuredPost.date)}</time>
            {featuredPost.categories[0] && (
              <span>{content.categoryById.get(featuredPost.categories[0])?.name}</span>
            )}
          </div>
          <h2 id="blog-feature-title">
            <a href={`/blog/${featuredPost.slug}/`}>{plainText(featuredPost.title.rendered)}</a>
          </h2>
          <p>{plainText(featuredPost.excerpt.rendered)}</p>
          <a class="blog-read-link" href={`/blog/${featuredPost.slug}/`}>
            Leer artículo <span aria-hidden="true">↗</span>
          </a>
        </article>
      </section>
    )}

    {archivePosts.length > 0 && (
      <section class="blog-archive section-shell" aria-labelledby="blog-archive-title">
        <div class="blog-archive-heading">
          <p class="page-kicker">Archivo reciente</p>
          <h2 id="blog-archive-title">Notas, casos y cuidados.</h2>
          <p class="tabular">{String(archivePosts.length).padStart(2, "0")} lecturas</p>
        </div>
        <div class="blog-feed">
          {archivePosts.map((post, index) => (
            <article class="blog-feed-item">
              <p class="blog-feed-number tabular">{String(index + 2).padStart(2, "0")}</p>
              <a class="blog-feed-media" href={`/blog/${post.slug}/`}>
                <img
                  src={postImage(content, post)}
                  alt={`Imagen del artículo: ${plainText(post.title.rendered)}`}
                  width="960"
                  height="720"
                  loading="lazy"
                  decoding="async"
                />
              </a>
              <div class="blog-feed-copy">
                <p class="blog-card-meta">
                  <time datetime={post.date}>{formatDate(post.date)}</time>
                  {post.isDemo && <span>Contenido de muestra</span>}
                  {post.categories[0] && (
                    <span>{content.categoryById.get(post.categories[0])?.name}</span>
                  )}
                </p>
                <h3><a href={`/blog/${post.slug}/`}>{plainText(post.title.rendered)}</a></h3>
                <p>{plainText(post.excerpt.rendered)}</p>
                <a class="blog-read-link" href={`/blog/${post.slug}/`}>
                  Seguir leyendo <span aria-hidden="true">↗</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}
  </main>
  <ContactSection />
</BaseLayout>

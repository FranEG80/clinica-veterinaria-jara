---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ContactSection from "../components/ContactSection.astro";
import { fallbackMedia, getClinicContent, mediaSrcSet, mediaUrl } from "../lib/wordpress";

const content = await getClinicContent();
const gallery = content.media
  .filter((item) => /^home_vet_gallery\d*$/.test(item.slug))
  .sort((a, b) => a.id - b.id)
  .map((item, index) => ({
    src: item.source_url,
    srcSet: mediaSrcSet(item),
    alt: item.alt_text || `Mascota de una familia de Clínica Veterinaria Jara, foto ${index + 1}`,
    width: item.media_details?.width ?? 1200,
    height: item.media_details?.height ?? 900,
  }));

const images = gallery.length
  ? gallery
  : [
      {
        src: fallbackMedia.hero,
        srcSet: undefined,
        alt: "Paciente de Clínica Veterinaria Jara",
        width: 1200,
        height: 900,
      },
      {
        src: fallbackMedia.consulta,
        srcSet: undefined,
        alt: "Consulta veterinaria",
        width: 1200,
        height: 900,
      },
      {
        src: fallbackMedia["sala-de-espera"],
        srcSet: undefined,
        alt: "Sala de espera de la clínica",
        width: 1200,
        height: 900,
      },
    ];
const heroImage = images[0]?.src ?? mediaUrl(content, "clinica-veterinaria-jara-quienes-somos", "hero");
---

<BaseLayout
  title="Galería de mascotas | Clínica Veterinaria Jara"
  description="Algunos de los pacientes que forman parte del mundo de Clínica Veterinaria Jara."
  image={heroImage}
>
  <PageHero
    label="Galería"
    title="Ellos son el <i>centro</i><br />de todo."
    intro="Una pequeña ventana a las mascotas y familias que dan sentido a nuestro trabajo."
    image={heroImage}
    imageAlt="Mascota de Clínica Veterinaria Jara"
    accent="coral"
  />

  <section class="gallery-section section-shell" aria-label="Galería de mascotas">
    {images.map((item, index) => (
      <figure class:list={["gallery-item", "reveal-block", item.height > item.width ? "gallery-item-portrait" : "gallery-item-landscape"]}>
        <button
          class="gallery-image-button"
          type="button"
          data-gallery-lightbox-source={item.src}
          data-gallery-lightbox-alt={item.alt}
          data-gallery-lightbox-caption={`JARA · ${String(index + 1).padStart(2, "0")}`}
          aria-label={`Ampliar imagen ${index + 1} de la galería`}
        >
          <img
            src={item.src}
            srcset={item.srcSet}
            sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
            alt={item.alt}
            width={item.width}
            height={item.height}
            loading={index < 3 ? "eager" : "lazy"}
            decoding="async"
          />
          <span class="gallery-image-hint" aria-hidden="true">Ampliar</span>
        </button>
        <figcaption class="tabular">JARA · {String(index + 1).padStart(2, "0")}</figcaption>
      </figure>
    ))}
  </section>
  <dialog class="image-modal gallery-modal" data-gallery-modal aria-labelledby="gallery-modal-title">
    <form method="dialog" class="image-modal-close-form">
      <button class="image-modal-close" type="submit" aria-label="Cerrar imagen">
        <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
          <path d="m4 4 12 12M16 4 4 16" fill="none" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </button>
    </form>
    <div class="image-modal-inner">
      <p id="gallery-modal-title" class="sr-only">Imagen ampliada de la galería</p>
      <img data-gallery-modal-image src={heroImage} alt="" />
      <p data-gallery-modal-caption></p>
    </div>
  </dialog>
  <ContactSection />
</BaseLayout>

<script>
  const galleryModal = document.querySelector<HTMLDialogElement>("[data-gallery-modal]");
  const galleryModalImage = galleryModal?.querySelector<HTMLImageElement>("[data-gallery-modal-image]");
  const galleryModalCaption = galleryModal?.querySelector<HTMLElement>("[data-gallery-modal-caption]");
  const galleryTriggers = [
    ...document.querySelectorAll<HTMLButtonElement>("[data-gallery-lightbox-source]"),
  ];

  if (galleryModal && galleryModalImage && galleryModalCaption) {
    const galleryModalDefaultSrc = galleryModalImage.src;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    // Un único nombre compartido: en cada momento lo lleva la miniatura
    // pinchada o la imagen del modal, nunca las dos a la vez. El navegador
    // interpola tamaño y posición entre quien lo tenía antes y quien lo
    // tiene después — así la miniatura crece hasta ocupar el modal en vez
    // de que el modal aparezca aparte.
    const MORPH_NAME = "gallery-lightbox";
    let activeThumb: HTMLImageElement | null = null;

    const canMorph = () =>
      typeof document.startViewTransition === "function" && !reduceMotion.matches;

    const fillModal = (trigger: HTMLButtonElement) => {
      galleryModalImage.src = trigger.dataset.galleryLightboxSource ?? "";
      galleryModalImage.alt = trigger.dataset.galleryLightboxAlt ?? "Imagen ampliada de la galería";
      galleryModalCaption.textContent = trigger.dataset.galleryLightboxCaption ?? "Galería de mascotas";
    };

    const openGalleryImage = (trigger: HTMLButtonElement) => {
      const thumb = trigger.querySelector<HTMLImageElement>("img");
      const show = () => {
        if (typeof galleryModal.showModal === "function") galleryModal.showModal();
        else galleryModal.setAttribute("open", "");
      };

      if (!thumb || !canMorph()) {
        fillModal(trigger);
        show();
        return;
      }

      activeThumb = thumb;
      thumb.style.viewTransitionName = MORPH_NAME;
      document.startViewTransition(() => {
        thumb.style.viewTransitionName = "";
        fillModal(trigger);
        galleryModalImage.style.viewTransitionName = MORPH_NAME;
        show();
      });
    };

    const closeGalleryImage = () => {
      if (!activeThumb || !canMorph() || !galleryModal.open) {
        galleryModal.close();
        return;
      }

      const thumb = activeThumb;
      galleryModalImage.style.viewTransitionName = MORPH_NAME;
      document.startViewTransition(() => {
        galleryModalImage.style.viewTransitionName = "";
        galleryModal.close();
        thumb.style.viewTransitionName = MORPH_NAME;
      }).finished.finally(() => {
        thumb.style.viewTransitionName = "";
      });
    };

    galleryTriggers.forEach((trigger) => {
      trigger.addEventListener("click", () => openGalleryImage(trigger));
    });

    galleryModal.addEventListener("click", (event) => {
      if (event.target === galleryModal) closeGalleryImage();
    });

    galleryModal.querySelector("form")?.addEventListener("submit", (event) => {
      event.preventDefault();
      closeGalleryImage();
    });

    galleryModal.addEventListener("close", () => {
      galleryModalImage.src = galleryModalDefaultSrc;
    });
  }
</script>

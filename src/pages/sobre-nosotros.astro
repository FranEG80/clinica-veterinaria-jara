---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ContactSection from "../components/ContactSection.astro";
import ClinicProof from "../components/ClinicProof.astro";
import { getClinicContent, mediaSrcSetBySlug, mediaUrl } from "../lib/wordpress";
import { teamProfiles } from "../lib/site";

const content = await getClinicContent();
const heroImage = mediaUrl(content, "sala-de-espera");
const heroImageSrcSet = mediaSrcSetBySlug(content, "sala-de-espera");
const team = teamProfiles.map((member) => ({
  ...member,
  image: mediaUrl(content, member.mediaSlug, member.fallbackKey),
  imageSrcSet: mediaSrcSetBySlug(content, member.mediaSlug),
}));

const specialties = [
  ...new Set(team.map((member) => member.specialty).filter(Boolean)),
].slice(0, 5);
---

<BaseLayout
  title="La clínica | Clínica Veterinaria Jara"
  description="Conoce la historia, las instalaciones y el equipo de Clínica Veterinaria Jara en Villanueva de Córdoba."
  image={heroImage}
>
  <PageHero
    label="La clínica"
    title="Ciencia que cuida. Personas que<br /><i class='solo'>acompañan.</i>"
    intro="Desde 2015 unimos medicina veterinaria, tecnología y una relación cercana con cada familia."
    image={heroImage}
    imageSrcSet={heroImageSrcSet}
    imageAlt="Sala de espera de Clínica Veterinaria Jara"
    accent="coral"
  />

  <section
    class="clinic-intro section-shell"
    aria-labelledby="clinic-intro-title"
  >
    <h2 id="clinic-intro-title">Clínica Veterinaria Jara</h2>
    <div class="clinic-intro-copy">
      <p>
        La clínica fue fundada en 2015 por los veterinarios Jessica Bernabé Rico
        y Raúl Castro Berzosa. Un nuevo concepto de clínica en la comarca de Los
        Pedroches en el que se ofrecen los servicios de cirugía general,
        hospitalización, UCI, diagnóstico por imagen y los últimos avances en
        tecnología de laboratorio.
      </p>
      <p>
        El objetivo común que comparten los fundadores de Clínica Veterinaria
        Jara es su pasión por los animales, participando y apoyando las
        actividades de las protectoras de animales de la zona.
      </p>
      <p>
        Siempre pensando en seguir formándose y actualizando conocimientos para
        ofrecer el mejor servicio a las mascotas.
      </p>
    </div>
  </section>
  <section>
    <ClinicProof standalone />
  </section>

  <section class="team-section team-section-tinted" id="equipo" aria-labelledby="team-title">
    <div class:list={["section-shell", "team-heading", "reveal-block"]}>
      <div class="team-heading-copy">
        <p class="page-kicker team-kicker">El equipo · Jara</p>
        <h2 id="team-title">
          Profesionales<br />que <i>conocen</i><br />su historia.
        </h2>
        <p>
          Un equipo veterinario y auxiliar que combina experiencia,
          actualización constante y atención cercana.
        </p>
        {
          specialties.length > 0 && (
            <ul class="team-specialties" aria-label="Áreas del equipo">
              {specialties.map((specialty) => (
                <li>{specialty}</li>
              ))}
            </ul>
          )
        }
      </div>
    </div>

    <div class="team-portrait-grid section-shell">
      {
        team.map((member, index) => (
          <article class={`team-portrait team-portrait-${index + 1}`}>
            {/* El reveal va en la foto, no en `.team-portrait`: ese elemento ya
                tiene su propio `transform` para el desfase vertical alterno
                de la retícula, y compartir la propiedad con la animación
                hacía que una pisara a la otra. El delay es fijo por índice
                (no depende del orden en que dispare el IntersectionObserver),
                para que la cascada se lea de arriba/izquierda a abajo/derecha
                siguiendo el orden real de la retícula. */}
            <figure class="team-portrait-media reveal-block" style={`--reveal-delay: ${index * 90}ms`}>
              <img
                src={member.image}
                srcset={member.imageSrcSet}
                sizes="(min-width: 1024px) 22vw, (min-width: 768px) 30vw, 46vw"
                alt={`${member.name}, ${member.role.toLowerCase()}`}
                width="1200"
                height="1800"
                loading={index < 2 ? "eager" : "lazy"}
                decoding="async"
              />
            </figure>
            <div class="team-portrait-copy">
              <div>
                <h3>{member.name}</h3>
                <p>{member.role}</p>
              </div>
              <span>{member.specialty}</span>
            </div>
          </article>
        ))
      }
    </div>
  </section>
  <section
    class="principles-section section-shell"
    aria-labelledby="principles-title"
  >
    <div class="principles-heading">
      <p class="page-kicker">Nuestra forma de trabajar</p>
      <h2 id="principles-title"><i>Entender</i> primero.<br /><i>Explicar</i> siempre.</h2>
    </div>
    <div class="principles-list">
      <article data-accent="coral">
        <span class="principle-index tabular" aria-hidden="true">01</span>
        <div class="principle-body">
          <h3>Escucha clínica</h3>
          <p>
            Cada caso empieza por conocer al paciente, su historia y lo que
            preocupa a su familia.
          </p>
        </div>
      </article>
      <article data-accent="cyan">
        <span class="principle-index tabular" aria-hidden="true">02</span>
        <div class="principle-body">
          <h3>Decisiones claras</h3>
          <p>
            Explicamos las pruebas, las alternativas y el seguimiento con
            lenguaje comprensible.
          </p>
        </div>
      </article>
      <article data-accent="lime">
        <span class="principle-index tabular" aria-hidden="true">03</span>
        <div class="principle-body">
          <h3>Cuidado continuo</h3>
          <p>
            La atención no termina en consulta: acompañamos la evolución y cada
            nueva etapa.
          </p>
        </div>
      </article>
    </div>
  </section>
  
  <ContactSection />
</BaseLayout>

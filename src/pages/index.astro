---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroOrbit from "../components/HeroOrbit.astro";
import ClinicStory from "../components/ClinicStory.astro";
import ServiceExplorer from "../components/ServiceExplorer.astro";
import TeamRail from "../components/TeamRail.astro";
import ContactSection from "../components/ContactSection.astro";
import {
  clinicServices,
  fallbackMedia,
  getClinicContent,
  mediaSrcSetBySlug,
  mediaUrl,
  services,
} from "../lib/wordpress";
import { teamProfiles } from "../lib/site";

const content = await getClinicContent();

const heroImage = mediaUrl(content, "peluqueria", "peluqueria");
const heroImageSrcSet = mediaSrcSetBySlug(content, "peluqueria");
const consultationImage = mediaUrl(content, "consulta");
const consultationImageSrcSet = mediaSrcSetBySlug(content, "consulta");
const clinicImage = "/assets/jara-paciente.jpeg";
const waitingRoomImage = mediaUrl(content, "sala-de-espera");
const waitingRoomImageSrcSet = mediaSrcSetBySlug(content, "sala-de-espera");
const surgeryImage = mediaUrl(content, "quirofano");
const surgeryImageSrcSet = mediaSrcSetBySlug(content, "quirofano");
const teamGroupImage = "https://veterinariajara.es/wp-content/uploads/2022/09/NOSOTROS.jpg";
const teamGroupImageSrcSet = mediaSrcSetBySlug(content, "nosotros");

const serviceViews = clinicServices.map((service) => ({
  ...service,
  image: mediaUrl(content, service.mediaSlug, service.mediaSlug),
  imageSrcSet: mediaSrcSetBySlug(content, service.mediaSlug),
  gallery: service.gallerySlugs
    .map((slug) => mediaUrl(content, slug, slug))
    .filter((value): value is string => Boolean(value)),
}));

const team = teamProfiles.map((member) => ({
  ...member,
  image: mediaUrl(content, member.mediaSlug, member.fallbackKey),
  imageSrcSet: mediaSrcSetBySlug(content, member.mediaSlug),
}));

const schema = {
  "@context": "https://schema.org",
  "@type": "VeterinaryCare",
  name: "Clínica Veterinaria Jara",
  url: "https://veterinariajara.es/",
  image: heroImage ?? fallbackMedia.hero,
  email: "contacto@clinicaveterinariajara.es",
  telephone: "+34 957 120 563",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Calle Olivareros, 7",
    postalCode: "14440",
    addressLocality: "Villanueva de Córdoba",
    addressRegion: "Córdoba",
    addressCountry: "ES",
  },
};
---

<BaseLayout>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />

  <HeroOrbit
    heroImage={heroImage}
    heroImageSrcSet={heroImageSrcSet}
    consultationImage={consultationImage}
    consultationImageSrcSet={consultationImageSrcSet}
    waitingRoomImage={waitingRoomImage}
    waitingRoomImageSrcSet={waitingRoomImageSrcSet}
    surgeryImage={surgeryImage}
    surgeryImageSrcSet={surgeryImageSrcSet}
    featuredServices={services.slice(0, 4)}
  />

  <ClinicStory
    clinicImage={clinicImage}
    clinicImageAlt="Paciente canino frente a la entrada de Clínica Veterinaria Jara"
    portraitImage
    cta={[{ href: "/sobre-nosotros/", label: "Conócenos" }]}
  />
  <ServiceExplorer items={serviceViews} />
  <TeamRail
    members={team}
    featuredImage={teamGroupImage}
    featuredImageSrcSet={teamGroupImageSrcSet}
    featuredImageAlt="Equipo de Clínica Veterinaria Jara"
    ctaHref="/sobre-nosotros/"
    ctaLabel="Conócenos"
    accentHeading
  />
  <ContactSection />
</BaseLayout>

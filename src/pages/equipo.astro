---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import TeamPortraits from "../components/TeamPortraits.astro";
import ContactSection from "../components/ContactSection.astro";
import { getClinicContent, mediaUrl } from "../lib/wordpress";
import { teamProfiles } from "../lib/site";

const content = await getClinicContent();
const team = teamProfiles.map((member) => ({
  ...member,
  image: mediaUrl(content, member.mediaSlug, member.fallbackKey),
}));
const heroImage = mediaUrl(content, "jessica", "jessica");
---

<BaseLayout
  title="Equipo veterinario | Clínica Veterinaria Jara"
  description="Conoce al equipo veterinario y auxiliar de Clínica Veterinaria Jara."
  image={heroImage}
>
  <PageHero
    label="Equipo Jara"
    title="Especialistas, pero sobre todo cercanos."
    intro="Un equipo multidisciplinar que comparte información, experiencia y una misma manera de cuidar."
    image={heroImage}
    imageAlt="Profesional del equipo de Clínica Veterinaria Jara"
    accent="cyan"
  />
  <TeamPortraits members={team} />
  <section class="team-statement section-shell">
    <p>Veterinaria, cirugía, diagnóstico, hospitalización y cuidado auxiliar trabajan como una sola órbita alrededor de cada paciente.</p>
  </section>
  <ContactSection />
</BaseLayout>

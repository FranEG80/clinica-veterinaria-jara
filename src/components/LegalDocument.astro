---
import BaseLayout from "../layouts/BaseLayout.astro";

type Props = { title: string; updated: string; description?: string };
const { title, updated, description } = Astro.props;
---

<BaseLayout title={`${title} | Clínica Veterinaria Jara`} description={description}>
  <header class="legal-header section-shell">
    <p class="page-kicker">Información legal</p>
    <h1>{title}</h1>
    <p class="legal-updated">Última actualización: {updated}</p>
  </header>
  <article class="wp-prose legal-prose">
    <slot />
  </article>
</BaseLayout>

<style>
  .legal-updated {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    letter-spacing: 0.02em;
    opacity: 0.7;
  }
</style>

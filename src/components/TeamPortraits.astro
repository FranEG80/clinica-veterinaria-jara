---
type TeamMember = {
  name: string;
  role: string;
  specialty: string;
  image: string;
};

type Props = { members: TeamMember[] };
const { members } = Astro.props;
---

<section class="team-portraits" aria-labelledby="team-portraits-title">
  <div class="section-shell team-portraits-intro">
    <div>
      <p class="page-kicker">El equipo al completo</p>
      <p class="team-portraits-count tabular" aria-label={`${members.length} profesionales`}>
        {String(members.length).padStart(2, "0")}
      </p>
    </div>
    <h2 id="team-portraits-title">Una mirada distinta.<br />Un mismo criterio clínico.</h2>
    <p>
      Compartimos cada caso, cada duda y cada avance. Así construimos una atención más precisa,
      más humana y realmente coordinada.
    </p>
  </div>

  <div class="team-portrait-grid section-shell">
    {members.map((member, index) => (
      <article class={`team-portrait team-portrait-${index + 1}`}>
        <figure class="team-portrait-media">
          <img
            src={member.image}
            alt={`${member.name}, ${member.role.toLowerCase()}`}
            width="1200"
            height="1800"
            loading={index < 2 ? "eager" : "lazy"}
            decoding="async"
          />
          <span class="team-portrait-number tabular" aria-hidden="true">
            {String(index + 1).padStart(2, "0")}
          </span>
        </figure>
        <div class="team-portrait-copy">
          <div>
            <h3>{member.name}</h3>
            <p>{member.role}</p>
          </div>
          <span>{member.specialty}</span>
        </div>
      </article>
    ))}
  </div>
</section>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getClinicContent, plainText, safeWordPressHtml } from "../lib/wordpress";

type Props = { slug: string; fallbackTitle: string };
const { slug, fallbackTitle } = Astro.props;
const content = await getClinicContent();
const page = content.pageBySlug.get(slug);
const title = page ? plainText(page.title.rendered) : fallbackTitle;
const html = page?.content.rendered ?? "<p>Contenido legal disponible en WordPress.</p>";
---

<BaseLayout title={`${title} | Clínica Veterinaria Jara`} noIndex>
  <header class="legal-header section-shell">
    <p class="page-kicker">Información legal</p>
    <h1>{title}</h1>
  </header>
  <article class="wp-prose legal-prose" set:html={safeWordPressHtml(html)} />
</BaseLayout>

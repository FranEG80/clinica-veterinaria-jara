---
import type { Service } from "../lib/wordpress";

type ServiceView = Service & { image: string; imageSrcSet?: string };
type Props = {
  items: ServiceView[];
  showHeading?: boolean;
};
const { items, showHeading = true } = Astro.props;
const initial = items[0];
---

<section
  class="services-section section-shell"
  id="servicios"
  aria-labelledby={showHeading ? "services-title" : undefined}
  aria-label={showHeading ? undefined : "Servicios veterinarios"}
>
  {showHeading && (
    <div class="services-heading reveal-block">
      <h2 id="services-title">
        Todo lo que <i>necesitan.</i><br />En un mismo <i>lugar.</i>
      </h2>
      <p>
        Prevención, diagnóstico y tratamiento conectados por un equipo que conoce cada caso.
      </p>
    </div>
  )}

  <div class="service-explorer" data-service-explorer>
    <div class="service-list" aria-label="Servicios veterinarios">
      {items.map((service, index) => (
        <a
          class:list={["service-row", { "is-active": index === 0 }]}
          href={`/${service.slug}/`}
          data-service-item
          data-slug={service.slug}
          data-image={service.image}
          data-image-srcset={service.imageSrcSet}
          data-title={service.title}
          data-summary={service.summary}
          data-accent={service.accent}
        >
          <div class="service-row-copy">
            {showHeading ? (
              <h3 transition:name={`service-title-${service.slug}`}>{service.title}</h3>
            ) : (
              <h2 transition:name={`service-title-${service.slug}`}>{service.title}</h2>
            )}
            <p>{service.summary}</p>
          </div>
          <span class="service-link-label">Ver servicio</span>
          <img
            class="service-row-image"
            src={service.image}
            srcset={service.imageSrcSet}
            sizes="100vw"
            alt={`Servicio de ${service.title} en Clínica Veterinaria Jara`}
            width="960"
            height="720"
            loading="lazy"
            decoding="async"
            transition:name={`service-image-${service.slug}`}
          />
        </a>
      ))}
    </div>

    <figure class="service-preview" data-service-preview data-accent={initial.accent}>
      <div class="service-preview-frame">
        {/* Dos `<img>` apiladas: la visible tiene `.is-active` y lleva el
            `transition:name` del servicio actual, para que al hacer clic la
            imagen viaje hasta el hero de la ficha de servicio. La otra queda
            lista para recibir la siguiente imagen y cruzar en opacidad. */}
        <img
          class="service-preview-image is-active"
          src={initial.image}
          srcset={initial.imageSrcSet}
          sizes="(min-width: 1024px) 46vw, 40vw"
          alt=""
          aria-hidden="true"
          width="960"
          height="720"
          loading="lazy"
          decoding="async"
          data-service-image
          data-slug={initial.slug}
          transition:name={`service-image-${initial.slug}`}
        />
        <img
          class="service-preview-image"
          src={initial.image}
          srcset={initial.imageSrcSet}
          sizes="(min-width: 1024px) 46vw, 40vw"
          alt=""
          aria-hidden="true"
          width="960"
          height="720"
          loading="lazy"
          decoding="async"
          data-service-image
        />
        <div class="preview-acrylic" aria-hidden="true"></div>
      </div>
      <figcaption>
        <strong data-service-title>{initial.title}</strong>
        <span data-service-summary>{initial.summary}</span>
      </figcaption>
    </figure>
  </div>
</section>

<script>
  const serviceExplorer = document.querySelector<HTMLElement>("[data-service-explorer]");

  if (serviceExplorer) {
    const rows = [...serviceExplorer.querySelectorAll<HTMLElement>("[data-service-item]")];
    const preview = serviceExplorer.querySelector<HTMLElement>("[data-service-preview]");
    const images = [...serviceExplorer.querySelectorAll<HTMLImageElement>("[data-service-image]")];
    const title = serviceExplorer.querySelector<HTMLElement>("[data-service-title]");
    const summary = serviceExplorer.querySelector<HTMLElement>("[data-service-summary]");
    let active = rows[0];

    const selectService = (row: HTMLElement) => {
      if (row === active || !preview || !title || !summary || images.length < 2) return;
      active = row;
      rows.forEach((item) => item.classList.toggle("is-active", item === row));

      const nextTitle = row.dataset.title ?? "Servicio veterinario";
      const nextSlug = row.dataset.slug ?? "";
      const front = images.find((img) => img.classList.contains("is-active")) ?? images[0];
      const back = images.find((img) => img !== front) ?? images[1];

      back.src = row.dataset.image ?? back.src;
      back.srcset = row.dataset.imageSrcset ?? "";
      back.dataset.slug = nextSlug;
      // El nombre de la vista viaja con la imagen que en cada momento está
      // activa, no con un elemento fijo: si el visitante recorre varias
      // filas antes de hacer clic, la transición sigue enlazando con la
      // ficha de servicio correcta.
      back.style.viewTransitionName = `service-image-${nextSlug}`;
      front.style.viewTransitionName = "";

      // El intercambio de capas ocurre en el siguiente fotograma para que el
      // navegador registre el `src` nuevo antes de cruzar la opacidad.
      requestAnimationFrame(() => {
        back.classList.add("is-active");
        front.classList.remove("is-active");
      });

      title.textContent = nextTitle;
      summary.textContent = row.dataset.summary ?? "";
      preview.dataset.accent = row.dataset.accent ?? "lime";
    };

    rows.forEach((row) => {
      row.addEventListener("pointerenter", () => selectService(row));
      row.addEventListener("focus", () => selectService(row));
    });
  }
</script>

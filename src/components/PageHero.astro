---
type Props = {
  title: string;
  intro: string;
  label: string;
  image: string;
  imageSrcSet?: string;
  imageAlt: string;
  accent?: "lime" | "coral" | "cyan" | "orange";
};

const { title, intro, label, image, imageSrcSet, imageAlt, accent = "lime" } = Astro.props;
---

<header class="page-hero" data-accent={accent}>
  <div class="page-hero-copy">
    <p class="page-kicker">{label}</p>
    <h1 set:html={title} />
    <p class="page-intro">{intro}</p>
    <slot name="actions" />
  </div>

  <figure class="page-hero-media">
    <img
      src={image}
      srcset={imageSrcSet}
      sizes="(min-width: 1024px) 59vw, 100vw"
      alt={imageAlt}
      width="1200"
      height="900"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <span class="page-hero-field" aria-hidden="true"></span>
  </figure>
</header>

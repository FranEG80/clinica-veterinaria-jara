---
import "@fontsource/barlow-condensed/600.css";
import "@fontsource/barlow-condensed/700.css";
import "@fontsource-variable/bricolage-grotesque";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ClientRouter } from "astro:transitions";
// Los `?url` resuelven al archivo final (con hash en build), así se puede
// precargar la fuente sin adivinar el nombre que genera Vite.
import barlowCondensed600 from "@fontsource/barlow-condensed/files/barlow-condensed-latin-600-normal.woff2?url";
import barlowCondensed700 from "@fontsource/barlow-condensed/files/barlow-condensed-latin-700-normal.woff2?url";
import bricolageGrotesque from "@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url";

type Props = {
  title?: string;
  description?: string;
  image?: string;
  currentPath?: string;
  noIndex?: boolean;
  canonicalPath?: string;
};

const DEFAULT_SOCIAL_IMAGE = "/assets/og-jara.jpg";
const DEFAULT_SOCIAL_IMAGE_WIDTH = "1568";
const DEFAULT_SOCIAL_IMAGE_HEIGHT = "1003";

const normalizeOrigin = (value?: string) => {
  if (!value) return undefined;
  return value.startsWith("http://") || value.startsWith("https://")
    ? value
    : `https://${value}`;
};

const {
  title = "Clínica Veterinaria Jara | Villanueva de Córdoba",
  description = "Cirugía, diagnóstico por imagen, hospitalización, laboratorio y medicina interna con atención veterinaria cercana.",
  image = DEFAULT_SOCIAL_IMAGE,
  currentPath = Astro.url.pathname,
  noIndex = true,
  canonicalPath = Astro.url.pathname,
} = Astro.props;

const canonical = new URL(canonicalPath, Astro.site);
// `site` must remain the official domain for canonical URLs. Static builds do
// not know the final preview host, so use the deploy origin for social assets.
const deployOrigin =
  normalizeOrigin(import.meta.env.PUBLIC_DEPLOY_ORIGIN) ??
  normalizeOrigin(import.meta.env.VERCEL_URL) ??
  normalizeOrigin(import.meta.env.DEPLOY_PRIME_URL) ??
  normalizeOrigin(import.meta.env.CF_PAGES_URL) ??
  Astro.url.origin;
const socialImage = new URL(image, deployOrigin);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#fcfcfc" />
    <meta name="description" content={description} />
    {
      noIndex ? (
        <meta
          name="robots"
          content="noindex, nofollow, noarchive, nosnippet, noimageindex, noai, noimageai"
        />
      ) : (
        <meta name="robots" content="index,follow,max-image-preview:large" />
      )
    }
    {
      noIndex && (
        <meta
          name="googlebot"
          content="noindex,nofollow,noarchive,nosnippet,noimageindex"
        />
      )
    }
    <link rel="preconnect" href="https://veterinariajara.es" />
    <link rel="preload" as="font" type="font/woff2" href={barlowCondensed700} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={barlowCondensed600} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={bricolageGrotesque} crossorigin />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Clínica Veterinaria Jara" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    {
      image === DEFAULT_SOCIAL_IMAGE && (
        <>
          <meta property="og:image:type" content="image/jpeg" />
          <meta property="og:image:width" content={DEFAULT_SOCIAL_IMAGE_WIDTH} />
          <meta property="og:image:height" content={DEFAULT_SOCIAL_IMAGE_HEIGHT} />
        </>
      )
    }
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={title} />
    <title>{title}</title>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <!--
      THESIS: El cuidado real aparece dentro de una órbita cromática; se rechaza el hero veterinario genérico de foto amable y tarjetas iguales.
      OWN-WORLD: Blanco mineral, tinta casi negra, fotografía de la clínica y grandes planos acrílicos coral, cian, lima y naranja unidos por líneas finas.
      STORY: El visitante reconoce cercanía y capacidad clínica, explora servicios y contacta por cita, urgencia o email.
      FIRST VIEWPORT: Navegación de 72px; titular y dos acciones a la izquierda; collage orbital arquitectónico a la derecha; servicios visibles en el borde inferior.
      FORM: Órbita Jara, dirección 7, comp A Collage orbital; seed 1bfbbe43.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
    -->
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header currentPath={currentPath} />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  import type { TransitionBeforePreparationEvent } from "astro:transitions/client";

  // Vive en el layout, no en index.astro: `.reveal-block` se usa en varias
  // páginas (p. ej. /sobre-nosotros/), y antes solo animaba en la home.
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");

  type LayoutWindow = Window & {
    __jaraLayoutCleanup?: () => void;
  };

  const layoutWindow = window as LayoutWindow;
  layoutWindow.__jaraLayoutCleanup?.();
  const controller = new AbortController();
  let revealObserver: IntersectionObserver | undefined;
  let raf = 0;

  layoutWindow.__jaraLayoutCleanup = () => {
    controller.abort();
    revealObserver?.disconnect();
    if (raf) cancelAnimationFrame(raf);
  };

  // Safari (de escritorio y iOS) parpadea al abrir/cerrar el `<dialog>` de
  // las imágenes: su soporte de `@starting-style`/`allow-discrete` sobre
  // `dialog`/`::backdrop`, combinado con la View Transition del morph de la
  // galería, no es tan maduro como en Chrome. Se detecta una sola vez aquí
  // (no por función) y el resto del CSS/JS lo consulta vía esta clase.
  // Excluye Chrome, Chromium-based y Firefox/Chrome en iOS, que también
  // incluyen "Safari" en su user agent al ser WebKit por mandato de Apple.
  if (/^((?!chrome|crios|fxios|android).)*safari/i.test(navigator.userAgent)) {
    document.documentElement.classList.add("is-safari");
  }

  const hero = document.querySelector<HTMLElement>("[data-orbit-hero]");
  if (hero && !reduceMotion.matches) {
    const LERP = 0.14;
    const REST = 0.0005;
    let targetX = 0;
    let targetY = 0;
    let targetScroll = 0;
    let currentX = 0;
    let currentY = 0;
    let currentScroll = 0;
    // El suavizado vive aquí (lerp por fotograma), no en una `transition`
    // CSS: así cada capa sigue al puntero 1:1 sin quedarse medio segundo
    // por detrás, y el gesto se puede redirigir en cualquier instante.
    const tick = () => {
      currentX += (targetX - currentX) * LERP;
      currentY += (targetY - currentY) * LERP;
      currentScroll += (targetScroll - currentScroll) * LERP;
      hero.style.setProperty("--pointer-x", currentX.toFixed(4));
      hero.style.setProperty("--pointer-y", currentY.toFixed(4));
      hero.style.setProperty("--hero-scroll", currentScroll.toFixed(4));

      const settled =
        Math.abs(targetX - currentX) < REST &&
        Math.abs(targetY - currentY) < REST &&
        Math.abs(targetScroll - currentScroll) < REST;

      if (settled) {
        raf = 0;
        hero.classList.toggle("is-animating", targetScroll > REST);
        return;
      }
      raf = requestAnimationFrame(tick);
    };

    const ensureLoop = () => {
      hero.classList.add("is-animating");
      if (!raf) raf = requestAnimationFrame(tick);
    };

    if (finePointer.matches) {
      hero.addEventListener(
        "pointermove",
        (event) => {
          const bounds = hero.getBoundingClientRect();
          targetX = (event.clientX - bounds.left) / bounds.width - 0.5;
          targetY = (event.clientY - bounds.top) / bounds.height - 0.5;
          ensureLoop();
        },
        { signal: controller.signal },
      );

      hero.addEventListener(
        "pointerleave",
        () => {
          targetX = 0;
          targetY = 0;
          ensureLoop();
        },
        { signal: controller.signal },
      );
    }

    window.addEventListener(
      "scroll",
      () => {
        targetScroll = Math.min(1, Math.max(0, window.scrollY / window.innerHeight));
        ensureLoop();
      },
      { passive: true, signal: controller.signal },
    );
  }

  const revealBlocks = [...document.querySelectorAll<HTMLElement>(".reveal-block")];
  if (revealBlocks.length && !reduceMotion.matches && "IntersectionObserver" in window) {
    document.documentElement.classList.add("motion-ready");
    revealObserver = new IntersectionObserver(
      (entries) => {
        // Los bloques que entran en el mismo fotograma se escalonan ~60ms
        // entre sí, en vez de aparecer todos a la vez. Si el propio bloque ya
        // trae un `--reveal-delay` puesto en el marcado (una retícula que
        // quiere una cascada en su propio orden, no en el orden de disparo
        // del observer, que no es fiable espacialmente), se respeta y no se
        // sobrescribe.
        entries
          .filter((entry) => entry.isIntersecting)
          .forEach((entry, index) => {
            const target = entry.target as HTMLElement;
            if (!target.style.getPropertyValue("--reveal-delay")) {
              target.style.setProperty("--reveal-delay", `${index * 60}ms`);
            }
            target.classList.add("is-visible");
            revealObserver?.unobserve(target);
          });
      },
      { rootMargin: "0px 0px -10% 0px", threshold: 0.12 },
    );
    revealBlocks.forEach((block) => revealObserver?.observe(block));
  }

  // La entrada a una ficha de servicio (lista -> detalle) viaja bien: el
  // navegador empareja los nombres de vista por slug sin ayuda. La vuelta
  // (detalle -> lista, por el botón atrás o cualquier enlace) es harina de
  // otro costal: Astro restaura el scroll a donde estaba el visitante antes
  // de entrar (una función suya, no de esto), y al hacerlo dentro de la
  // animación de la transición, el salto se ve brusco y feo pase lo que
  // pase con los nombres de vista — no es un problema de emparejamiento.
  //
  // La solución es no transicionar esa vuelta en absoluto. `astro:before-
  // preparation` permite cancelar una navegación concreta con
  // `preventDefault()`, y Astro cae entonces a una navegación normal del
  // navegador para esa página: sin transición, sin salto acompañado de
  // animación, el comportamiento de toda la vida al pulsar "atrás".
  document.addEventListener(
    "astro:before-preparation",
    (event: TransitionBeforePreparationEvent) => {
      if (document.querySelector(".service-page-hero")) event.preventDefault();
    },
    { signal: controller.signal },
  );
</script>

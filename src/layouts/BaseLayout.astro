---
import "@fontsource/barlow-condensed/600.css";
import "@fontsource/barlow-condensed/700.css";
import "@fontsource-variable/bricolage-grotesque";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

type Props = {
  title?: string;
  description?: string;
  image?: string;
  currentPath?: string;
  noIndex?: boolean;
  canonicalPath?: string;
};

const DEFAULT_SOCIAL_IMAGE = "/assets/og-jara.jpg";

const {
  title = "Clínica Veterinaria Jara | Villanueva de Córdoba",
  description = "Cirugía, diagnóstico por imagen, hospitalización, laboratorio y medicina interna con atención veterinaria cercana.",
  image = "/assets/og-jara.jpg",
  currentPath = Astro.url.pathname,
  noIndex = true,
  canonicalPath = Astro.url.pathname,
} = Astro.props;

const canonical = new URL(canonicalPath, Astro.site);
const socialImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#fcfcfc" />
    <meta name="description" content={description} />
    {
      noIndex ? (
        <>
          <meta
            name="robots"
            content="noindex,nofollow,noarchive,nosnippet,noimageindex"
          />
          <meta
            name="googlebot"
            content="noindex,nofollow,noarchive,nosnippet,noimageindex"
          />
          <meta name="robots" content="noai, noimageai" />
        </>
      ) : (
        <meta name="robots" content="index,follow,max-image-preview:large" />
      )
    }
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Clínica Veterinaria Jara" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    {
      image === DEFAULT_SOCIAL_IMAGE && (
        <>
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      )
    }
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
  </head>
  <body>
    <!--
      THESIS: El cuidado real aparece dentro de una órbita cromática; se rechaza el hero veterinario genérico de foto amable y tarjetas iguales.
      OWN-WORLD: Blanco mineral, tinta casi negra, fotografía de la clínica y grandes planos acrílicos coral, cian, lima y naranja unidos por líneas finas.
      STORY: El visitante reconoce cercanía y capacidad clínica, explora servicios y contacta por cita, urgencia o email.
      FIRST VIEWPORT: Navegación de 72px; titular y dos acciones a la izquierda; collage orbital arquitectónico a la derecha; servicios visibles en el borde inferior.
      FORM: Órbita Jara, dirección 7, comp A Collage orbital; seed 1bfbbe43.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
    -->
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header currentPath={currentPath} />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
  </body>
</html>

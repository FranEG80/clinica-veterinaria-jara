---
import "@fontsource/barlow-condensed/600.css";
import "@fontsource/barlow-condensed/700.css";
import "@fontsource-variable/bricolage-grotesque";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

type Props = {
  title?: string;
  description?: string;
  image?: string;
  currentPath?: string;
  noIndex?: boolean;
  canonicalPath?: string;
};

const {
  title = "Clínica Veterinaria Jara | Villanueva de Córdoba",
  description = "Cirugía, diagnóstico por imagen, hospitalización, laboratorio y medicina interna con atención veterinaria cercana.",
  image = "https://veterinariajara.es/wp-content/uploads/2022/09/Clinica-Veterinaria-Jara-Quienes-Somos.jpg",
  currentPath = Astro.url.pathname,
  noIndex = false,
  canonicalPath = Astro.url.pathname,
} = Astro.props;

const canonical = new URL(canonicalPath, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#fcfcfc" />
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Clínica Veterinaria Jara" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body>
    <!--
      THESIS: El cuidado real aparece dentro de una órbita cromática; se rechaza el hero veterinario genérico de foto amable y tarjetas iguales.
      OWN-WORLD: Blanco mineral, tinta casi negra, fotografía de la clínica y grandes planos acrílicos coral, cian, lima y naranja unidos por líneas finas.
      STORY: El visitante reconoce cercanía y capacidad clínica, explora servicios y contacta por cita, urgencia o email.
      FIRST VIEWPORT: Navegación de 72px; titular y dos acciones a la izquierda; collage orbital arquitectónico a la derecha; servicios visibles en el borde inferior.
      FORM: Órbita Jara, dirección 7, comp A Collage orbital; seed 1bfbbe43.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
    -->
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header currentPath={currentPath} />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
  </body>
</html>
